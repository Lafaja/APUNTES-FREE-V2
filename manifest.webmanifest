{
  "name": "Tablet Studio · Apuntes y PDF",
  "short_name": "Tablet Studio",
  "description": "Apuntes a mano y PDF anotados, sin conexión y privados.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f3f5f9",
  "theme_color": "#ffffff",
  "lang": "es",
  "categories": ["productivity", "education", "utilities"],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "file", "accept": [".tstudio", "application/x-tstudio", "application/octet-stream", "application/zip", ".pdf", "application/pdf"] }]
    }
  },
  "file_handlers": [{ "action": "./", "accept": { "application/x-tstudio": [".tstudio"] } }],
  "icons": [
    { "src": "icons/logo.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
